# Contributor: Björn Busse <bj.rn@baerlin.eu>
# Maintainer: Björn Busse <bj.rn@baerlin.eu>
pkgname=uutils
pkgver=0.11.0
pkgrel=0
pkgdesc="uutils coreutils, built as one multicall binary with only the utilities moonshine needs"
url="https://github.com/uutils/coreutils"
arch="all"
license="MIT"
# Alpine's uutils-coreutils compiles in every utility (~100) and owns the same
# paths in /usr/bin. Ours is the same upstream, cut down to _utils below
depends="!uutils-coreutils"
makedepends="cargo"
source="uutils-coreutils-$pkgver.tar.gz::https://github.com/uutils/coreutils/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/coreutils-$pkgver"
# The test suite wants GNU's, plus a checkout of it; nothing here is validated
# by running it. !tracedeps is deliberately NOT set: the so-deps apk records
# are what turn a libc mismatch into a resolution error instead of a crash
options="!check"

# The utilities compiled into the binary. One per line, alphabetical -- adding
# one is a single-line diff, then a pkgrel bump and a rebuild.
#
# Anything in uutils' feat_os_unix_musl set is safe to add. `stdbuf` is the one
# that is not: it needs a cdylib, which musl targets do not support, which is
# why upstream keeps feat_require_unix_musl separate from feat_require_unix.
# Names come from the [features] table in the upstream Cargo.toml, where each
# utility is an optional dependency of the same name.
#
# uptime reports "0 users" here and always will: musl implements the utmpx
# functions as stubs, so there is no login database to count. The uptime and
# load-average figures come from /proc and are correct
_utils="
	cat
	chmod
	chown
	cp
	date
	env
	head
	ln
	ls
	mkdir
	mktemp
	mv
	rm
	rmdir
	sleep
	sort
	stat
	tail
	touch
	uname
	uptime
	wc
	"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	# -p coreutils, not a bare `cargo build`: the workspace lists src/uu/* as
	# members, so building the workspace compiles every utility crate whatever
	# --features says. Only the root package honours the feature selection.
	#
	# --no-default-features drops feat_common_core, which is 78 utilities
	cargo build -p coreutils --release --frozen \
		--no-default-features --features "$(echo $_utils)"
}

package() {
	install -Dm755 "$builddir"/target/release/coreutils \
		"$pkgdir"/usr/bin/coreutils

	# One binary plus a symlink per utility, the busybox arrangement: separate
	# binaries would repeat the Rust runtime and uucore in every one of them.
	# The list comes from the binary itself rather than from $_utils, so the
	# links cannot drift from what was actually compiled in
	"$builddir"/target/release/coreutils --list | while read -r _u; do
		[ -n "$_u" ] || continue
		ln -s coreutils "$pkgdir"/usr/bin/"$_u"
	done
}
sha512sums="
e6fb56df6a02403ef8887b32fe14113162fdcf673ccc6ec2c96c811c461cabf91d5e002c0969506a63323b47369ad19c2a74bd2029f87788f6ef4d47e07277b5  uutils-coreutils-0.11.0.tar.gz
"

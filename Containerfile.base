# moonshine base image -- musl + brush, from scratch
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause
#
# Stage 1 uses Alpine purely as a host for apk; nothing from it is inherited.
# apk --root builds a fresh rootfs, brush is added from a signed apk, and
# stage 2 copies that tree onto an empty image.
#
# There is no busybox and no other shell: /bin/sh is brush
#

ARG ALPINE_TAG=3.24
ARG ALPINE_BRANCH=v3.24

FROM docker.io/library/alpine:${ALPINE_TAG} AS bootstrap
ARG ALPINE_BRANCH

# brush is not in the Alpine repos -- it comes from a signed apk published at
# github.com/bbusse/alpine-brush-build. It is the shell, so it is not optional
ARG BRUSH_VERSION=0.4.0
ARG BRUSH_PKGREL=0

# none   = brush builtins only
# uutils = add uutils, this repo's cut-down build of the Rust coreutils --
#          one multicall binary holding only the utilities listed in
#          uutils/apkbuild/APKBUILD, not Alpine's ~100-utility package.
ARG UTILS=none

# Which moonshine release to take uutils from, and the pkgver/pkgrel it was
# published under (from uutils/apkbuild/APKBUILD). Only read when
# UTILS=uutils
ARG MOONSHINE_VERSION=v0-rc1
ARG UUTILS_PKGVER=0.10.0
ARG UUTILS_PKGREL=0

# Put apk itself in the image
ARG WITH_APK=0

ENV ROOT=/rootfs

# Deliberately absent from this list: busybox and alpine-baselayout.
# alpine-baselayout carries a file dependency on /bin/sh, which only
# busybox-binsh provides, so requiring it drags busybox back in. We take
# alpine-baselayout-data (the /etc files, no dependencies) and build the
# directory tree ourselves below
RUN <<'SCRIPT'
set -eu
pkgs="musl"                        # the libc and /lib/ld-musl-$ARCH.so.1 loader
pkgs="$pkgs alpine-baselayout-data" # /etc/passwd, /etc/group, /etc/hosts, /etc/shells
pkgs="$pkgs ca-certificates-bundle" # /etc/ssl/certs/ca-certificates.crt, for any TLS
pkgs="$pkgs tzdata"                 # without this, local time silently yields UTC

# uutils is not in this list: it is fetched from a moonshine release further
# down, the same way brush and sway-pixman are. Validated here so a typo fails
# before anything is downloaded.
case "$UTILS" in
    none) ;;
    # Rust binaries link libgcc_s for stack unwinding, so the rootfs needs it
    # before the uutils apk will resolve. Alpine's uutils-coreutils depends on
    # it for the same reason. Only pulled in with uutils
    uutils) pkgs="$pkgs libgcc" ;;
    *) echo "unknown UTILS=$UTILS (want: none, uutils)" >&2; exit 1 ;;
esac

if [ "$WITH_APK" = "1" ]; then
    pkgs="$pkgs apk-tools alpine-keys"
fi

apk add --no-cache --initdb --root "$ROOT" \
    --repository "https://dl-cdn.alpinelinux.org/alpine/${ALPINE_BRANCH}/main" \
    --repository "https://dl-cdn.alpinelinux.org/alpine/${ALPINE_BRANCH}/community" \
    --keys-dir /etc/apk/keys \
    $pkgs
SCRIPT

# The filesystem layout alpine-baselayout would have provided, minus its
# /bin/sh dependency on busybox.
RUN <<'SCRIPT'
set -eu
ROOT="${ROOT:?}"

for d in bin sbin lib \
         usr/bin usr/sbin usr/lib usr/share usr/local/bin usr/local/sbin usr/local/lib \
         etc/profile.d etc/apk/keys \
         var/log var/cache var/lib var/spool var/empty \
         run root home media mnt opt srv \
         dev proc sys tmp var/tmp; do
    mkdir -p "$ROOT/$d"
done

chmod 1777 "$ROOT/tmp" "$ROOT/var/tmp"
chmod 0700 "$ROOT/root"
chmod 0555 "$ROOT/var/empty"

# These two are symlinks in a normal Alpine root. Test with -L, not -e:
# both point at paths that do not exist in the build stage, so -e is false
# even when the link is already there (alpine-baselayout-data ships /etc/mtab)
[ -L "$ROOT/var/run" ] || ln -s /run "$ROOT/var/run"
[ -L "$ROOT/etc/mtab" ] || ln -s /proc/mounts "$ROOT/etc/mtab"
SCRIPT

# Identify the image as moonshine rather than as the Alpine it was assembled
# from. /etc/os-release belongs to alpine-release, which this rootfs does not
# install, so there is nothing here to overwrite and no apk-owned file to
# diverge from.
#
# os-release(5): the canonical copy lives at /usr/lib/os-release with
# /etc/os-release a relative symlink to it, which is how Alpine ships it too.
# VERSION_ID drops the leading "v" of the release tag -- the spec asks for the
# version alone, and Alpine does the same (VERSION_ID=3.24.1, branch v3.24).
RUN <<'SCRIPT'
set -eu
ROOT="${ROOT:?}"
VERSION_ID="${MOONSHINE_VERSION#v}"

cat > "$ROOT/usr/lib/os-release" <<RELEASE
NAME="moonshine"
ID=moonshine
ID_LIKE=alpine
VERSION="${VERSION_ID}"
VERSION_ID="${VERSION_ID}"
PRETTY_NAME="moonshine ${VERSION_ID}"
HOME_URL="https://github.com/bbusse/moonshine"
BUG_REPORT_URL="https://github.com/bbusse/moonshine/issues"
RELEASE

ln -sfn ../usr/lib/os-release "$ROOT/etc/os-release"
SCRIPT

# Repositories and cache, so apk works inside the image
RUN <<'SCRIPT'
set -eu
if [ "$WITH_APK" != "1" ]; then exit 0; fi
BRANCH="${ALPINE_BRANCH:?}"
ROOT="${ROOT:?}"

[ -x "$ROOT/sbin/apk" ] || { echo "apk-tools not installed" >&2; exit 1; }

mkdir -p "$ROOT/etc/apk" "$ROOT/var/cache/apk"
cat > "$ROOT/etc/apk/repositories" <<REPOS
https://dl-cdn.alpinelinux.org/alpine/${BRANCH}/main
https://dl-cdn.alpinelinux.org/alpine/${BRANCH}/community
REPOS

# apk resolves this relative to its own root, so the cache has to be reachable
# from inside the image rather than from the build stage
ln -sfn /var/cache/apk "$ROOT/etc/apk/cache"
SCRIPT

# The key the brush release is signed with. Inline so the build needs no
# context; regenerate from bbusse/alpine-brush-build if it is ever rotated
RUN <<'SCRIPT'
set -eu
cat > /etc/apk/keys/apk-releases.rsa.pub <<'KEY'
-----BEGIN PUBLIC KEY-----
MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA0jsW8N8Taync3kV83e9s
BbrGY4UGkTmVE4ASeHi6CpNKWoSMdrRpEGJQv38BfzFSIXKm64NbmGIRE9PcYvNa
s+nNxasAJu8TH+XY/ZNx3oUABpNEpy5UCNSGQmCLkKi7Cdk3WBikb5OPPAdRznqV
bN0dEPFv+Xr2fXljDzHDdb98Zct6zbmvkkCpBuRuHzmybyCbsZFC1171azJB3k+N
DMDFfGD51TX62l+mNjwgEaMTEwg+iwR5LroR63q27bQrIb4E2BqmGdPG67Tm1oK9
ArB5zx5STq8iALRI8j7sJUo9mFHMtt7DkOv0Vxn4j/OAj62HK5Ie39PeCLOgDT1P
2lM0tyv8jnd4v3PU5VYqnfrUjomqsTUIg61Xjy5WNTtH3nFMS/5Gk+kcrfGbKcMO
haE+8h45QnyqEF6UWTjciBsvoPyrM82ni6t/8AIoGDe4GCZYdAD4RzwUmxdU2wOz
EqsHkXDzx/3WbUAZF9f+5bYFu7/qe8qQXzwU1nPBJEvv1wvFj4qzh0ru6BIUvPfs
t1PBAGis/Dkisefx0gyaNms3q7rBu8xRylRIDSIWZZGoPscCzLpZBIsud3SfFuLz
61Rb9FKvWilEWBr5uq2tQCQehyh1oBHQXxYjb7EvojQ7tFdRmtY9jy1GQT2a1TNf
LMR0onqB3UphAvYeW+z5zBsCAwEAAQ==
-----END PUBLIC KEY-----
KEY
cat > /checksums.txt <<'SUMS'
# sha256 of the apks this image pulls in. Two independent checks run on each:
# the pin says "the same artifact we pinned", which catches a re-cut release
# under an existing tag; apk's signature check says "built by the key we
# trust". Neither subsumes the other.
#
# brush, from https://github.com/bbusse/alpine-brush-build/releases
# Regenerate with: make brush-checksums BRUSH_VERSION=x.y.z
a610db78a6d3f0c757c0f1a70fe6d01db399939e01c226c8a6d18d22aeb4bc19  aarch64-brush-0.4.0-r0.apk
98bdca3b87a5fbef6dcd875afd4dd6b307774b916175d1b75c56750ce7a68003  x86_64-brush-0.4.0-r0.apk
#
# uutils, from https://github.com/bbusse/moonshine/releases
# Regenerate with:
#   make uutils-checksums MOONSHINE_VERSION=<tag> UUTILS_PKGVER=<x.y.z> UUTILS_PKGREL=<n>
0a9ec199bf99877e006b8b30ee990e615fbc77c445d5db45ac489fa6f804cb8b  uutils-0.10.0-r0.aarch64-v0-rc1.apk
111a0d05894c157b9a5290e9c977f335e72248c29fcb0b8ed6db29ed8057e646  uutils-0.10.0-r0.x86_64-v0-rc1.apk
SUMS

# One fetch-and-verify path, used by both the brush and uutils steps below.
# Having it in one place is the point: this is the code that decides whether an
# unverified apk gets installed, and a second copy can drift from the first.
cat > /usr/local/bin/fetch-apk <<'HELPER'
#!/bin/sh
# fetch-apk <url-base> <asset> <dest>
set -eu
url_base="$1"; asset="$2"; dest="$3"
expected="$(awk -v a="$asset" '$2 == a { print $1 }' /checksums.txt)"
if [ -z "$expected" ]; then
    echo "no checksum pinned for $asset" >&2
    exit 1
fi
echo "fetching $asset"
wget -q -O "$dest" "${url_base}/${asset}"
echo "${expected}  ${dest}" | sha256sum -c - >/dev/null
echo "checksum ok"
HELPER
chmod +x /usr/local/bin/fetch-apk
SCRIPT

RUN <<'SCRIPT'
set -eu
ARCH="$(apk --print-arch)"
fetch-apk "https://github.com/bbusse/alpine-brush-build/releases/download/v${BRUSH_VERSION}" \
    "${ARCH}-brush-${BRUSH_VERSION}-r${BRUSH_PKGREL}.apk" /brush.apk

install -D -m 0644 /etc/apk/keys/apk-releases.rsa.pub \
    "$ROOT/etc/apk/keys/apk-releases.rsa.pub"
apk add --no-cache --root "$ROOT" --keys-dir /etc/apk/keys /brush.apk
rm -f /brush.apk
SCRIPT

# Build and install brush-binsh, the package that declares brush as the
# provider of /bin/sh.
RUN <<'SCRIPT'
set -eu
VERSION="${BRUSH_VERSION:?}"
PKGREL="${BRUSH_PKGREL:-0}"
ROOT="${ROOT:?}"
# abuild runs as an unprivileged user and has to read the private key, so it
# lives in the builder's home; only the public half goes where apk looks.
KEY=/home/builder/.abuild/moonshine-local.rsa

apk add --no-cache abuild >/dev/null
adduser -D -G abuild builder 2>/dev/null || true
mkdir -p /home/builder/.abuild

openssl genrsa -out "$KEY" 4096 2>/dev/null
# abuild-sign reads the public half from beside the private one, and names the
# signature after that filename; apk then looks the key up by the same name.
openssl rsa -in "$KEY" -pubout -out "${KEY}.pub" 2>/dev/null
install -m 0644 "${KEY}.pub" /etc/apk/keys/moonshine-local.rsa.pub

W=/tmp/aports/moonshine/brush-binsh
mkdir -p "$W"
cat > /home/builder/.abuild/abuild.conf <<CONF
PACKAGER_PRIVKEY="$KEY"
PACKAGER="moonshine <none@localhost>"
CONF

cat > "$W/APKBUILD" <<APKBUILD
pkgname=brush-binsh
pkgver=${VERSION}
pkgrel=${PKGREL}
pkgdesc="brush as /bin/sh"
url="https://github.com/reubeno/brush"
arch="all"
license="MIT"
depends="brush=${VERSION}-r${PKGREL}"
provides="/bin/sh cmd:sh"
provider_priority=100
source=""
options="!check !strip !tracedeps"

package() {
    mkdir -p "\$pkgdir"/bin
    ln -s /usr/bin/brush "\$pkgdir"/bin/sh
}
APKBUILD

chown -R builder:abuild "$W" /home/builder
# -d skips dependency install: there is nothing to compile, and the runtime
# depends on brush would otherwise have to be resolvable in the build stage.
su builder -c "cd $W && abuild -d" >/dev/null 2>&1

pkg="$(find /home/builder/packages -name 'brush-binsh-*.apk' | head -n 1)"
[ -n "$pkg" ] || { echo "brush-binsh build produced nothing" >&2; exit 1; }
apk add --no-cache --root "$ROOT" --keys-dir /etc/apk/keys "$pkg"

[ "$(readlink "$ROOT/bin/sh")" = /usr/bin/brush ] \
    || { echo "brush-binsh did not create /bin/sh" >&2; exit 1; }
SCRIPT

# Make brush the system shell in the rootfs.
RUN <<'SCRIPT'
set -eu
BRUSH=/usr/bin/brush
ROOT="${ROOT:?}"

[ -x "$ROOT$BRUSH" ] || { echo "brush not installed at $BRUSH" >&2; exit 1; }

# /bin/sh belongs to the brush-binsh package built above, so that apk knows
# brush provides it; only the convenience alias is made by hand. The symlink
# itself was already asserted there.
ln -sf "$BRUSH" "$ROOT/bin/brush"

# /etc/shells comes from alpine-baselayout-data listing busybox paths that do
# not exist in this image. Replace it rather than append.
printf '%s\n' "$BRUSH" /bin/sh /bin/brush > "$ROOT/etc/shells"

# root's login shell is /bin/sh in baselayout-data, which now resolves to
# brush; say so explicitly so the intent survives someone editing passwd.
sed -i "s#^root:x:0:0:root:/root:/bin/sh\$#root:x:0:0:root:/root:${BRUSH}#" \
    "$ROOT/etc/passwd"
SCRIPT

# uutils, when asked for. Signed by the same apk-releases key as brush -- this
# package is built and released by this repo's own CI (see
# .github/workflows/build-apk.yml), so the asset name carries both its
# pkgver/pkgrel and the moonshine release it was published under.
RUN <<'SCRIPT'
set -eu
if [ "$UTILS" != uutils ]; then exit 0; fi
ROOT="${ROOT:?}"
: "${MOONSHINE_VERSION:?set MOONSHINE_VERSION to the release uutils was published under}"

ARCH="$(apk --print-arch)"
fetch-apk "https://github.com/bbusse/moonshine/releases/download/${MOONSHINE_VERSION}" \
    "uutils-${UUTILS_PKGVER}-r${UUTILS_PKGREL}.${ARCH}-${MOONSHINE_VERSION}.apk" /uutils.apk

apk add --no-cache --root "$ROOT" --keys-dir /etc/apk/keys /uutils.apk
rm -f /uutils.apk

# The multicall binary is only useful through its symlinks; if package() ever
# stops making them, every utility silently disappears from PATH.
[ "$(readlink "$ROOT/usr/bin/ls")" = coreutils ] \
    || { echo "uutils installed but /usr/bin/ls is not a coreutils symlink" >&2; exit 1; }
SCRIPT

RUN <<'SCRIPT'
set -eu
rm -rf "$ROOT"/var/cache/apk/*
if [ "$WITH_APK" != "1" ]; then
    rmdir "$ROOT/var/cache/apk" 2>/dev/null || true
fi
apk info -v --root "$ROOT" | sort > "$ROOT/etc/moonshine-manifest"

# The whole point, asserted: if anything dragged busybox back in, stop here.
if apk info -e --root "$ROOT" busybox >/dev/null 2>&1; then
    echo "busybox got pulled in -- check the dependency chain" >&2
    exit 1
fi
SCRIPT

FROM scratch
COPY --from=bootstrap /rootfs/ /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LABEL org.opencontainers.image.title="moonshine-base" \
      org.opencontainers.image.description="Minimal musl rootfs with brush as the only shell" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.source="https://github.com/bbusse/moonshine"
CMD ["/bin/sh"]

# moonshine stage3 - a Gentoo stage3 built by Catalyst
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause
#
# Runs the builder from Containerfile.catalyst, which already carries the seed
# tarball, an installed Catalyst and a portage snapshot. All that is left is to
# write a spec and run it -- but that run is `emerge --emptytree @system`, i.e.
# the whole system set compiled from source. Hours, not minutes.
#
# Catalyst bind-mounts /proc /sys /dev into its build chroot, so this build
# needs elevated capabilities (podman build has no --privileged):
#   podman build --cap-add SYS_ADMIN --cap-add SYS_CHROOT \
#     --build-arg CATALYST_IMAGE=moonshine-catalyst:local \
#     --build-arg JOBS=$(nproc) \
#     -f Containerfile.stage3 -t moonshine-stage3:local .
#
# SUBARCH and PROFILE must match the seed baked into the catalyst image; an
# arm64 seed with an amd64 profile fails inside the chroot, not here.

ARG CATALYST_IMAGE=moonshine-catalyst:latest
ARG SUBARCH=amd64
# Empty by default and derived from SUBARCH below; override for a non-default
# profile (hardened, musl, llvm). The 23.0 profiles exist for amd64 and arm64.
ARG PROFILE=
ARG JOBS=4

FROM ${CATALYST_IMAGE} AS build
ARG SUBARCH
ARG PROFILE
ARG JOBS

# Write catalyst.conf and the stage3 spec
RUN <<'SCRIPT'
set -eu
mkdir -p /etc/catalyst

cat > /etc/catalyst/catalyst.conf <<CONF
storedir = "/var/tmp/catalyst"
distdir = "/var/cache/distfiles"
jobs = ${JOBS}
options = ["bindist"]
compression_mode = "xz"
CONF

PROFILE="${PROFILE:-default/linux/${SUBARCH}/23.0}"

snap=""
for f in /var/tmp/catalyst/snapshots/gentoo-*; do
    if [ -d "$f" ]; then snap="$f"; fi
done
[ -n "$snap" ] || { echo "no portage snapshot found" >&2; exit 1; }
treeish="${snap##*/gentoo-}"

cat > /var/tmp/catalyst/stage3.spec <<SPEC
subarch: ${SUBARCH}
target: stage3
version_stamp: container
rel_type: default
profile: ${PROFILE}
snapshot_treeish: ${treeish}
source_subpath: default/seed
SPEC
SCRIPT

# Build the stage3.  Catalyst chroots into the seed and runs
# emerge --emptytree @system inside it -- the whole system set, from source.
# This is the step the capabilities above are for.
RUN catalyst -f /var/tmp/catalyst/stage3.spec

# Copy the stage3 tarball Catalyst produced to a fixed path for extraction
RUN <<'SCRIPT'
set -eu
tarball=""
for f in /var/tmp/catalyst/builds/default/stage3-*container*.tar.xz; do
    if [ -e "$f" ]; then tarball="$f"; fi
done
if [ -z "$tarball" ]; then
    echo "Catalyst produced no stage3 tarball; builds dir holds:" >&2
    ls -l /var/tmp/catalyst/builds/default/ >&2
    exit 1
fi
cp "$tarball" /stage3.tar.xz
SCRIPT

FROM scratch
COPY --from=build /stage3.tar.xz /

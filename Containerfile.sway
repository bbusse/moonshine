# moonshine sway -- a Wayland compositor on an apk image,
# software rendering only
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause
#

ARG APK_IMAGE=moonshine-apk:latest
ARG ALPINE_TAG=3.22
ARG MOONSHINE_VERSION
ARG SWAY_PKGVER=1.12
ARG SWAY_PKGREL=0

FROM docker.io/library/alpine:${ALPINE_TAG} AS swayfetch
ARG MOONSHINE_VERSION
ARG SWAY_PKGVER
ARG SWAY_PKGREL
COPY brush/keys/apk-releases.rsa.pub /etc/apk/keys/apk-releases.rsa.pub
COPY sway-pixman/checksums.txt /checksums.txt
# Same two checks as Containerfile.base: a sha256 pin plus apk's own signature
# verification. Unlike brush, sway-pixman is built and released by this repo's
# own CI, so the asset name carries both its pkgver/pkgrel and the moonshine
# release it was published under.
#
# No comments inside the RUN: continuation lines are joined before the shell
# sees them, so a '#' would comment out the rest.
RUN set -eu; \
    : "${MOONSHINE_VERSION:?set MOONSHINE_VERSION to the release tag the apk was published under}"; \
    : "${SWAY_PKGVER:?set SWAY_PKGVER to the sway-pixman pkgver}"; \
    ARCH="$(apk --print-arch)"; \
    ASSET="sway-pixman-${SWAY_PKGVER}-r${SWAY_PKGREL}.${ARCH}-${MOONSHINE_VERSION}.apk"; \
    echo "fetching $ASSET"; \
    wget -q -O /sway-pixman.apk \
        "https://github.com/bbusse/moonshine/releases/download/${MOONSHINE_VERSION}/${ASSET}"; \
    expected="$(awk -v a="$ASSET" '$2 == a { print $1 }' /checksums.txt)"; \
    if [ -z "$expected" ]; then \
        echo "no checksum pinned for $ASSET -- add one to sway-pixman/checksums.txt" >&2; \
        exit 1; \
    fi; \
    echo "${expected}  /sway-pixman.apk" | sha256sum -c - >/dev/null; \
    echo "checksum ok"; \
    mkdir -p /packages && mv /sway-pixman.apk /packages/sway-pixman.apk

FROM ${APK_IMAGE}

# uutils-coreutils is not optional here the way it is in the base image: sway
# shells out (e.g. it calls uname during startup)
COPY --from=swayfetch /packages/sway-pixman.apk /tmp/packages/sway-pixman.apk
RUN apk add --no-cache uutils-coreutils /tmp/packages/sway-pixman.apk \
    && rm -rf /tmp/packages

COPY sway-pixman/config /etc/sway/config
COPY sway-pixman/smoke.sh /usr/local/bin/sway-smoke
RUN mkdir -p /etc/sway/config.d /run/user/0 && chmod 0700 /run/user/0

ENV XDG_RUNTIME_DIR=/run/user/0 \
    WLR_BACKENDS=headless \
    WLR_RENDERER=pixman \
    WLR_LIBINPUT_NO_DEVICES=1 \
    WLR_HEADLESS_OUTPUTS=1 \
    XDG_SESSION_TYPE=wayland

LABEL org.opencontainers.image.title="moonshine-sway" \
      org.opencontainers.image.description="sway, software rendering only, on a busybox-free musl image" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.source="https://github.com/bbusse/moonshine"

CMD ["/usr/bin/sway"]

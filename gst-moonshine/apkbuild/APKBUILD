# Contributor: Björn Busse <bj.rn@baerlin.eu>
# Maintainer: Björn Busse <bj.rn@baerlin.eu>
pkgname=gst-moonshine
pkgver=1.28.3
pkgrel=1
pkgdesc="The gstreamer plugin set moonshine consumers need, and nothing beyond it"
url="https://gstreamer.freedesktop.org"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# Alpine's packages ship every plugin, and gst-plugins-good alone pulls
# libsoup, gnutls, pulseaudio, FireWire and a tail of audio codecs -- 56
# packages and 32 MB for elements nothing here instantiates. These build what
# the moonshine consumers actually run: scream's rtsp/webm/jpeg pipelines, the
# iss-display controller's gst-launch encode pipelines (static-images, v4l2,
# mosaic), and its playbin3 media player -- HLS .m3u8 -> H.264, video only,
# onto waylandsink. No explicit !conflicts -- building needs gst-plugins-base-dev,
# which a conflict on its parent would break -- but the sets own the same
# file paths, so apk refuses to install both anyway.
#
# provides= impersonates Alpine's package names so the RELEASED scream apk,
# which depends on them, resolves here. That claim is broader than what is
# built: once scream ships depending on gst-moonshine directly, drop these
# (see ISSUES.md)
provides="gst-plugins-base=$pkgver gst-plugins-good=$pkgver
	gst-plugins-ugly=$pkgver gst-plugins-bad=$pkgver gst-rtsp-server=$pkgver"
provider_priority=10
makedepends="
	curl-dev
	glib-dev
	gst-plugins-base-dev
	gstreamer-dev
	libdrm-dev
	libjpeg-turbo-dev
	libogg-dev
	libpng-dev
	libtheora-dev
	libvpx-dev
	linux-headers
	meson
	nettle-dev
	ninja
	openh264-dev
	orc-dev
	pkgconf
	wayland-dev
	wayland-protocols
	x264-dev
	zlib-dev
	"
source="
	https://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-$pkgver.tar.xz
	https://gstreamer.freedesktop.org/src/gst-plugins-good/gst-plugins-good-$pkgver.tar.xz
	https://gstreamer.freedesktop.org/src/gst-plugins-ugly/gst-plugins-ugly-$pkgver.tar.xz
	https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-$pkgver.tar.xz
	https://gstreamer.freedesktop.org/src/gst-rtsp-server/gst-rtsp-server-$pkgver.tar.xz
	"
builddir="$srcdir"
options="!check"

# What each module contributes, from scream's and the controller's pipelines:
#   base   appsrc, videoconvert/videoscale, videotestsrc; theoraenc, oggmux
#          and tcpserversink for the controller's static-images/v4l2 streams,
#          rawvideoparse (rawparse) framing the mosaic stream's raw BGRA;
#          and the libraries the other modules and the rtsp server link
#   good   rtph264pay (rtp), rtpbin (rtpmanager), vp8enc (vpx),
#          jpegenc/jpegdec (jpeg), webmmux (matroska), pngdec (png),
#          v4l2src (v4l2), udpsink (udp)
#   ugly   x264enc, the encoder of the rtsp h264 stream; gpl=enabled is its
#          license gate, hence GPL in license= above
#   bad    hlsdemux (hls) and tsdemux (mpegtsdemux) to unwrap an HLS .m3u8,
#          h264parse (videoparsers) and openh264dec (openh264) to decode it
#          without gst-libav/ffmpeg, waylandsink (wayland) to put it on the
#          output, and curlhttpsrc (curl) as the HTTP source -- souphttpsrc
#          would pull libsoup, which iss-display's Containerfile guard forbids
#   rtsp-server  the server scream embeds
# playbin3/decodebin3/uridecodebin3/urisourcebin come from base's playback.
build() {
	local common="--auto-features=disabled
		-Dtests=disabled
		-Ddoc=disabled"

	cd "$srcdir/gst-plugins-base-$pkgver"
	abuild-meson $common \
		-Dapp=enabled \
		-Dplayback=enabled \
		-Dvideoconvertscale=enabled \
		-Dvideotestsrc=enabled \
		-Dtypefind=enabled \
		-Dorc=enabled \
		-Dtheora=enabled \
		-Dogg=enabled \
		-Dtcp=enabled \
		-Drawparse=enabled \
		-Dtools=disabled \
		-Dexamples=disabled \
		. output
	meson compile -C output -j "${JOBS:-$(nproc)}"

	cd "$srcdir/gst-plugins-good-$pkgver"
	abuild-meson $common \
		-Drtp=enabled \
		-Drtpmanager=enabled \
		-Dvpx=enabled \
		-Djpeg=enabled \
		-Dmatroska=enabled \
		-Dpng=enabled \
		-Dv4l2=enabled \
		-Dudp=enabled \
		-Dexamples=disabled \
		. output
	meson compile -C output -j "${JOBS:-$(nproc)}"

	cd "$srcdir/gst-plugins-ugly-$pkgver"
	abuild-meson $common \
		-Dgpl=enabled \
		-Dx264=enabled \
		. output
	meson compile -C output -j "${JOBS:-$(nproc)}"

	cd "$srcdir/gst-plugins-bad-$pkgver"
	abuild-meson $common \
		-Dhls=enabled \
		-Dhls-crypto=nettle \
		-Dmpegtsdemux=enabled \
		-Dvideoparsers=enabled \
		-Dopenh264=enabled \
		-Dwayland=enabled \
		-Dcurl=enabled \
		-Dexamples=disabled \
		. output
	meson compile -C output -j "${JOBS:-$(nproc)}"

	cd "$srcdir/gst-rtsp-server-$pkgver"
	abuild-meson $common \
		-Dexamples=disabled \
		. output
	meson compile -C output -j "${JOBS:-$(nproc)}"
}

package() {
	local m
	for m in gst-plugins-base gst-plugins-good gst-plugins-ugly gst-plugins-bad gst-rtsp-server; do
		DESTDIR="$pkgdir" meson install --no-rebuild -C "$srcdir/$m-$pkgver/output"
	done
	rm -rf "$pkgdir"/usr/include "$pkgdir"/usr/lib/pkgconfig \
	       "$pkgdir"/usr/share/gir-1.0 "$pkgdir"/usr/lib/girepository-1.0
}

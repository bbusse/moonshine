# moonshine brush image -- a shell, no libc
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause
#
# brush ships as a single statically linked binary, so it needs nothing
# underneath it: no musl, no busybox, no rootfs
#
# It has no coreutils to call, so it is a demonstration and a source layer to
# COPY from, not a working userland. For that, use moonshine-base (which
# carries brush too, unless built with WITH_BRUSH=0)

ARG ALPINE_TAG=3.22

FROM docker.io/library/alpine:${ALPINE_TAG} AS build
ARG BRUSH_VERSION=0.4.0
ARG BRUSH_PKGREL=0
COPY brush/keys/apk-releases.rsa.pub /etc/apk/keys/apk-releases.rsa.pub
COPY brush/checksums.txt /checksums.txt
COPY brush/fetch.sh /fetch.sh
RUN set -eu; \
    BRUSH_VERSION="${BRUSH_VERSION}" BRUSH_PKGREL="${BRUSH_PKGREL}" /fetch.sh; \
    apk add --no-cache --initdb --root /out --keys-dir /etc/apk/keys /brush.apk; \
    ! ldd /out/usr/bin/brush 2>/dev/null | grep -q '=>'; \
    mkdir -p /empty/tmp; chmod 1777 /empty/tmp

FROM scratch
COPY --from=build /out/usr/bin/brush /bin/brush
COPY --from=build /empty/tmp /tmp
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/
LABEL org.opencontainers.image.title="moonshine-brush" \
      org.opencontainers.image.description="brush, statically linked, on an empty image" \
      org.opencontainers.image.source="https://github.com/bbusse/alpine-brush-build"

ENTRYPOINT ["/bin/brush"]

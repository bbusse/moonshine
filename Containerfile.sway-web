# moonshine sway-web -- sway plus the software GL a browser engine needs
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause

ARG SWAY_IMAGE=moonshine-sway:latest
ARG ALPINE_TAG=3.24
ARG MOONSHINE_VERSION=v0-rc9
ARG MESA_PKGVER=26.1.6
ARG MESA_PKGREL=0
# softpipe or llvmpipe -- see the comment on the install below
ARG MESA_FLAVOUR=softpipe

FROM docker.io/library/alpine:${ALPINE_TAG} AS mesafetch
ARG MOONSHINE_VERSION
ARG MESA_PKGVER
ARG MESA_PKGREL
ARG MESA_FLAVOUR
RUN <<'SCRIPT'
set -eu
cat > /etc/apk/keys/apk-releases.rsa.pub <<'KEY'
-----BEGIN PUBLIC KEY-----
MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA0jsW8N8Taync3kV83e9s
BbrGY4UGkTmVE4ASeHi6CpNKWoSMdrRpEGJQv38BfzFSIXKm64NbmGIRE9PcYvNa
s+nNxasAJu8TH+XY/ZNx3oUABpNEpy5UCNSGQmCLkKi7Cdk3WBikb5OPPAdRznqV
bN0dEPFv+Xr2fXljDzHDdb98Zct6zbmvkkCpBuRuHzmybyCbsZFC1171azJB3k+N
DMDFfGD51TX62l+mNjwgEaMTEwg+iwR5LroR63q27bQrIb4E2BqmGdPG67Tm1oK9
ArB5zx5STq8iALRI8j7sJUo9mFHMtt7DkOv0Vxn4j/OAj62HK5Ie39PeCLOgDT1P
2lM0tyv8jnd4v3PU5VYqnfrUjomqsTUIg61Xjy5WNTtH3nFMS/5Gk+kcrfGbKcMO
haE+8h45QnyqEF6UWTjciBsvoPyrM82ni6t/8AIoGDe4GCZYdAD4RzwUmxdU2wOz
EqsHkXDzx/3WbUAZF9f+5bYFu7/qe8qQXzwU1nPBJEvv1wvFj4qzh0ru6BIUvPfs
t1PBAGis/Dkisefx0gyaNms3q7rBu8xRylRIDSIWZZGoPscCzLpZBIsud3SfFuLz
61Rb9FKvWilEWBr5uq2tQCQehyh1oBHQXxYjb7EvojQ7tFdRmtY9jy1GQT2a1TNf
LMR0onqB3UphAvYeW+z5zBsCAwEAAQ==
-----END PUBLIC KEY-----
KEY
cat > /checksums.txt <<'SUMS'
# sha256 of the mesa apks published at
# https://github.com/bbusse/moonshine/releases
# Both flavours are pinned; MESA_FLAVOUR decides which one is fetched
# Regenerate with: make mesa-checksums MOONSHINE_VERSION=<tag> MESA_PKGVER=<x.y.z> MESA_PKGREL=<n>
b1e9332fe92356a4cf24d3d7b30f32b4fdadd416a66f49b510643eebc72d5bc6  mesa-softpipe-26.1.6-r0.aarch64-v0-rc9.apk
326300d840aa29bdad5261f4897ca0ee14b20db9dd2dfd3e493953d0aad45cab  mesa-softpipe-26.1.6-r0.x86_64-v0-rc9.apk
ce529c61c04cffb534c41e86d7945af9be98c09977017496e5ce6f9fa66c1cf5  mesa-llvmpipe-26.1.6-r0.aarch64-v0-rc9.apk
686c48df59bfb30134f5094c51ce3ab38745329d67673c9ea030924fe5afb426  mesa-llvmpipe-26.1.6-r0.x86_64-v0-rc9.apk
SUMS
SCRIPT

# Same two checks as Containerfile.sway: a sha256 pin plus apk's own signature
# verification. The asset name carries its pkgver/pkgrel and the moonshine
# release it was published under
RUN <<'SCRIPT'
set -eu
: "${MOONSHINE_VERSION:?set MOONSHINE_VERSION to the release tag the apk was published under}"
: "${MESA_PKGVER:?set MESA_PKGVER to the mesa pkgver}"
: "${MESA_FLAVOUR:?set MESA_FLAVOUR to softpipe or llvmpipe}"

RELEASE="https://github.com/bbusse/moonshine/releases/download/${MOONSHINE_VERSION}"
ARCH="$(apk --print-arch)"

fetch_apk() {
    asset="$1"
    expected="$(awk -v a="$asset" '$2 == a { print $1 }' /checksums.txt)"
    if [ -z "$expected" ]; then
        echo "no checksum pinned for $asset" >&2
        exit 1
    fi
    echo "fetching $asset"
    wget -q -O "/packages/$2" "${RELEASE}/${asset}"
    echo "${expected}  /packages/$2" | sha256sum -c - >/dev/null
    echo "checksum ok"
}

mkdir -p /packages
fetch_apk "mesa-${MESA_FLAVOUR}-${MESA_PKGVER}-r${MESA_PKGREL}.${ARCH}-${MOONSHINE_VERSION}.apk" mesa.apk

# python-wayland consumers parse these two protocol XMLs at startup, and apk
# only ships them inside -dev packages that drag linux-headers and pkgconf
# into a runtime image. This image is the wayland base its consumers build on,
# so it carries the data files
apk add --no-cache wayland-dev wayland-protocols >/dev/null
mkdir -p /protocols/wayland /protocols/wayland-protocols/stable/xdg-shell
cp /usr/share/wayland/wayland.xml /protocols/wayland/
cp /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
   /protocols/wayland-protocols/stable/xdg-shell/
SCRIPT

FROM docker.io/library/alpine:${ALPINE_TAG} AS glstub
RUN <<'SCRIPT'
set -eu
apk add --no-cache abuild
adduser -D -G abuild builder
mkdir -p /home/builder/.abuild

KEY=/home/builder/.abuild/moonshine-local.rsa
openssl genrsa -out "$KEY" 4096 2>/dev/null
openssl rsa -in "$KEY" -pubout -out "${KEY}.pub" 2>/dev/null

cat > /home/builder/.abuild/abuild.conf <<CONF
PACKAGER_PRIVKEY="$KEY"
PACKAGER="moonshine <none@localhost>"
CONF

W=/tmp/aports/moonshine/gl-stub
mkdir -p "$W"
cat > "$W/APKBUILD" <<'APKBUILD'
pkgname=gl-stub
pkgver=1
pkgrel=0
pkgdesc="Claims so:libGL.so.1 for dlopen-only consumers"
url="https://github.com/bbusse/moonshine"
arch="all"
license="BSD-3-Clause"
# Only libGL. mesa-softpipe and mesa-llvmpipe ship a real libEGL and libGLESv2,
# so claiming those here would shadow them. Desktop GL is the one API a
# wayland-only mesa does not build -- it comes with glx, which would drag in
# X11 -- and gst-plugins-base declares so:libGL.so.1 for its opengl plugin,
# which nothing here loads
provides="so:libGL.so.1=1"
provider_priority=1
source=""
options="!check !strip !tracedeps"

package() {
    mkdir -p "$pkgdir"
}
APKBUILD

chown -R builder:abuild "$W" /home/builder
# abuild signs the apk and then indexes it, and the index step verifies the
# signature, so the throwaway key has to be trusted here too
cp "${KEY}.pub" /etc/apk/keys/

# stdout only: abuild is chatty, but hiding its stderr hides why it failed
su builder -c "cd $W && abuild -d" >/dev/null

pkg="$(find /home/builder/packages -name 'gl-stub-*.apk' | head -n 1)"
[ -n "$pkg" ] || { echo "gl-stub build produced nothing" >&2; exit 1; }
mkdir -p /out
cp "$pkg" /out/gl-stub.apk
cp "${KEY}.pub" /out/moonshine-local.rsa.pub
SCRIPT

FROM ${SWAY_IMAGE}

COPY --from=mesafetch /protocols/ /usr/share/
COPY --from=glstub /out/moonshine-local.rsa.pub /etc/apk/keys/moonshine-local.rsa.pub

# Two software rasterizers, one installed: softpipe links no llvm at all and
# costs 15 MB, but stops at OpenGL 3.3; llvmpipe JITs shaders and reaches 4.6,
# which is what wgpu needs, for 78 MB with llvm linked in. Alpine's own mesa is
# the third option and the worst of both -- llvmpipe against a shared
# llvm22-libs, 173 MB. servo runs on either; vju needs llvmpipe unless it is
# the vju-glow build
RUN --mount=type=bind,from=mesafetch,source=/packages,target=/tmp/packages \
    --mount=type=bind,from=glstub,source=/out,target=/tmp/glstub \
    apk add --no-cache /tmp/packages/mesa.apk /tmp/glstub/gl-stub.apk

RUN <<'SCRIPT'
set -eu
apk add --no-cache \
    font-dejavu \
    font-awesome

fc-cache -f

found="$(apk info -e mesa mesa-gl mesa-egl mesa-gles llvm22-libs x265-libs libSvtAv1Enc 2>/dev/null || true)"
if [ -n "$found" ]; then
    echo "pulled in by the solver despite the moonshine mesa: $found" >&2
    exit 1
fi

# gst-plugins-base is the consumer that needs so:libGL.so.1; if the stub stops
# satisfying it the solver reaches for mesa-gl and drags in the whole of mesa
apk add --no-cache --simulate gst-plugins-base >/dev/null 2>&1 || {
    echo "gst-plugins-base is unsatisfiable -- gl-stub is not covering libGL" >&2
    exit 1
}
SCRIPT

RUN <<'SCRIPT'
set -eu
mkdir -p /etc/sway/config.d
echo "xwayland disable" > /etc/sway/config.d/xwayland
SCRIPT

LABEL org.opencontainers.image.title="moonshine-sway-web" \
      org.opencontainers.image.description="sway with a software-only mesa for browser engines, no llvm" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.source="https://github.com/bbusse/moonshine"

CMD ["/usr/bin/sway"]

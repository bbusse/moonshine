# moonshine sway-web -- sway plus a wayland-native Firefox
#
# SPDX-FileCopyrightText: Björn Busse <bj.rn@baerlin.eu>
# SPDX-License-Identifier: BSD-3-Clause

ARG SWAY_IMAGE=moonshine-sway:latest
ARG ALPINE_TAG=3.24

FROM docker.io/library/alpine:${ALPINE_TAG} AS dlopenstubs
RUN <<'SCRIPT'
set -eu
apk add --no-cache abuild
adduser -D -G abuild builder
mkdir -p /home/builder/.abuild

KEY=/home/builder/.abuild/moonshine-local.rsa
openssl genrsa -out "$KEY" 4096 2>/dev/null
openssl rsa -in "$KEY" -pubout -out "${KEY}.pub" 2>/dev/null
install -m 0644 "${KEY}.pub" /etc/apk/keys/moonshine-local.rsa.pub

cat > /home/builder/.abuild/abuild.conf <<CONF
PACKAGER_PRIVKEY="$KEY"
PACKAGER="moonshine <none@localhost>"
CONF

W=/tmp/aports/moonshine/dlopen-stubs
mkdir -p "$W"
cat > "$W/APKBUILD" <<'APKBUILD'
pkgname=dlopen-stubs
pkgver=1
pkgrel=0
pkgdesc="Claims the libEGL, libGL and libavcodec deps firefox only dlopens"
url="https://github.com/bbusse/moonshine"
arch="all"
license="BSD-3-Clause"
provides="so:libEGL.so.1=1 so:libGL.so.1=1 ffmpeg-libavcodec=1"
provider_priority=1
source=""
options="!check !strip !tracedeps !archcheck !dbg"

package() {
    install -Dm644 /dev/null "$pkgdir"/usr/share/dlopen-stubs/.keep
}
APKBUILD

chown -R builder:abuild "$W" /home/builder
su builder -c "cd $W && abuild -d"

pkg="$(find /home/builder/packages -name 'dlopen-stubs-*.apk' | head -n 1)"
[ -n "$pkg" ] || { echo "dlopen-stubs build produced nothing" >&2; exit 1; }
mkdir -p /out
cp "$pkg" /out/dlopen-stubs.apk
cp "${KEY}.pub" /out/moonshine-local.rsa.pub
SCRIPT

FROM ${SWAY_IMAGE}

COPY --from=dlopenstubs /out/moonshine-local.rsa.pub /etc/apk/keys/moonshine-local.rsa.pub
COPY --from=dlopenstubs /out/dlopen-stubs.apk /tmp/dlopen-stubs.apk

RUN <<'SCRIPT'
set -eu
apk add --no-cache /tmp/dlopen-stubs.apk
rm -f /tmp/dlopen-stubs.apk

apk add --no-cache \
    firefox \
    geckodriver \
    sed \
    font-dejavu \
    font-awesome

fc-cache -f

found="$(apk info -e mesa mesa-gl mesa-egl mesa-gles x265-libs libSvtAv1Enc 2>/dev/null || true)"
if [ -n "$found" ]; then
    echo "pulled in by the solver despite dlopen-stubs: $found" >&2
    exit 1
fi

firefox --version
SCRIPT

RUN <<'SCRIPT'
set -eu
mkdir -p /etc/sway/config.d
echo "xwayland disable" > /etc/sway/config.d/xwayland
SCRIPT

ENV MOZ_ENABLE_WAYLAND=1 \
    GECKODRIVER=/usr/bin/geckodriver \
    FIREFOX_BIN=/usr/bin/firefox

LABEL org.opencontainers.image.title="moonshine-sway-web" \
      org.opencontainers.image.description="sway with a wayland-native Firefox and geckodriver, no mesa" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.source="https://github.com/bbusse/moonshine"

CMD ["/usr/bin/sway"]

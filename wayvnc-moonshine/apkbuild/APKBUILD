# Contributor: Björn Busse <bj.rn@baerlin.eu>
# Maintainer: Björn Busse <bj.rn@baerlin.eu>
pkgname=wayvnc-moonshine
pkgver=0.10.0
_neatvnc=1.0.0
pkgrel=0
pkgdesc="wayvnc with a neatvnc built without its ffmpeg h264 encoder linked in"
url="https://github.com/any1/wayvnc"
arch="all"
license="ISC"
# Alpine's neatvnc links libavcodec/avfilter/avutil for an h264 encoding the
# we do not use, saves 89 packages and ~110 MB
depends="!wayvnc"
makedepends="
	aml-dev
	gnutls-dev
	jansson-dev
	libdrm-dev
	libjpeg-turbo-dev
	libxkbcommon-dev
	linux-headers
	mesa-dev
	meson
	ninja
	pixman-dev
	pkgconf
	wayland-dev
	wayland-protocols
	zlib-dev
	"
source="
	neatvnc-$_neatvnc.tar.gz::https://github.com/any1/neatvnc/archive/refs/tags/v$_neatvnc.tar.gz
	wayvnc-$pkgver.tar.gz::https://github.com/any1/wayvnc/archive/refs/tags/v$pkgver.tar.gz
	"
builddir="$srcdir/wayvnc-$pkgver"
options="!check"

build() {
	# Installed into a prefix of its own so wayvnc's build finds headers and
	# the static archive at the paths the .pc files claim
	cd "$srcdir/neatvnc-$_neatvnc"
	meson setup output \
		--default-library=static \
		--prefix="$srcdir/nvnc" \
		--libdir="$srcdir/nvnc/lib" \
		--buildtype=release \
		-Dh264=disabled \
		-Dexamples=false \
		-Dtests=false
	meson compile -C output -j "${JOBS:-$(nproc)}"
	meson install -C output

	cd "$builddir"
	export PKG_CONFIG_PATH="$srcdir/nvnc/lib/pkgconfig"
	abuild-meson . output
	meson compile -C output -j "${JOBS:-$(nproc)}"
}

package() {
	cd "$builddir"
	install -Dm755 output/wayvnc "$pkgdir"/usr/bin/wayvnc
}
sha512sums="
